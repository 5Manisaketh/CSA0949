import java.util.HashSet;

public class TileSequences {
    public int numTilePossibilities(String tiles) {
        HashSet<String> set = new HashSet<>();
        backtrack("", tiles.toCharArray(), set);
        return set.size();
    }

    private void backtrack(String current, char[] tiles, HashSet<String> set) {
        if (!current.isEmpty()) set.add(current);
        for (int i = 0; i < tiles.length; i++) {
            if (tiles[i] == 0) continue;
            char temp = tiles[i];
            tiles[i] = 0;
            backtrack(current + temp, tiles, set);
            tiles[i] = temp;
        }
    }

    public static void main(String[] args) {
        TileSequences ts = new TileSequences();
        System.out.println(ts.numTilePossibilities("AAB"));
    }
}
