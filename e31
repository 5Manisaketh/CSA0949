import java.util.Arrays;
public class GCDLCM {
    static int gcd(int a, int b) {
        return (b == 0) ? a : gcd(b, a % b);
    }
    static long lcm(int a, int b) {
        return (long) a * b / gcd(a, b);
    }
    static long lcmOfArray(int[] arr) {
        long result = arr[0];
        for (int i = 1; i < arr.length; i++) {
            result = lcm((int) result, arr[i]);   }
        return result;   }
    static int gcdOfArray(int[] arr) {
        int result = arr[0];
        for (int i = 1; i < arr.length; i++) {
            result = gcd(result, arr[i]);
        }
        return result;
    }
    public static void main(String[] args) {
        int[] numbers = {12, 15, 20};
        System.out.println("GCD: " + gcdOfArray(numbers));
        System.out.println("LCM: " + lcmOfArray(numbers));
    }
}
