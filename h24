class Calculator implements Runnable {
    private String operation;
    private int a, b;

    Calculator(String operation, int a, int b) {
        this.operation = operation;
        this.a = a;
        this.b = b;
    }

    public void run() {
        switch (operation) {
            case "add":
                System.out.println("Addition: " + (a + b));
                break;
            case "subtract":
                System.out.println("Subtraction: " + (a - b));
                break;
            case "multiply":
                System.out.println("Multiplication: " + (a * b));
                break;
            case "divide":
                if (b != 0) {
                    System.out.println("Division: " + (a / b));
                } else {
                    System.out.println("Division by zero error");
                }
                break;
        }
    }
}

public class MultiThreadCalculator {
    public static void main(String[] args) {
        Thread t1 = new Thread(new Calculator("add", 10, 5));
        Thread t2 = new Thread(new Calculator("subtract", 10, 5));
        Thread t3 = new Thread(new Calculator("multiply", 10, 5));
        Thread t4 = new Thread(new Calculator("divide", 10, 5));

        t1.start();
        t2.start();
        t3.start();
        t4.start();
    }
}
