class SingleInstanceException extends Exception {
    public SingleInstanceException(String message) {
        super(message);
    }
}

class Singleton {
    private static Singleton instance;

    private Singleton() {}

    public static Singleton getInstance() throws SingleInstanceException {
        if (instance == null) {
            instance = new Singleton();
        } else {
            throw new SingleInstanceException("Only one instance allowed.");
        }
        return instance;
    }
}

public class Main {
    public static void main(String[] args) {
        try {
            Singleton obj1 = Singleton.getInstance();
            System.out.println("First instance created.");
            Singleton obj2 = Singleton.getInstance();
        } catch (SingleInstanceException e) {
            System.out.println(e.getMessage());
        }
    }
}
